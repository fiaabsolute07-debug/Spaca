APP_ENV=local
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://app_server:local_dev_only@127.0.0.1:55432/creator_marketplace
DATABASE_MIGRATION_URL=postgres://postgres:local_dev_only@127.0.0.1:55432/creator_marketplace
PLATFORM_FEE_BPS=0
PAYMENT_MODE=mock
LIVE_PAYMENTS_ENABLED=false
STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=.local/storage
# Production requires Supabase credentials and verified payment readiness.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVER_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Crypto settlement (SpacaEscrow). Local devnet simulation needs nothing. For anvil or Arc testnet (chain 5042002):
# CHAIN_RPC_URL_5042002=https://rpc.testnet.arc.io
# CHAIN_EXECUTOR_KEY_5042002=        # relayer that pays gas; holds no escrowed funds (testnet only, from a secret store)
# RELEASE_SIGNER_PRIVATE_KEY=        # signs payout authorizations; refused in production until KMS/multisig custody exists

