# spaca waitlist — copy to waitlist/.env.local and fill in. Never commit real values.

# Supabase: Project Settings → Database → Connection string.
# Runtime (serverless-friendly): transaction pooler, port 6543.
WAITLIST_DATABASE_URL=
# Migrations: direct connection (port 5432) or session pooler. Not the 6543 transaction pooler.
WAITLIST_MIGRATION_URL=

# 16+ random characters used to hash IP addresses for rate limiting.
WAITLIST_IP_SALT=

# Public origin used in email links, e.g. https://join.example.com
WAITLIST_PUBLIC_URL=

# Resend (https://resend.com): API key and a sender on a verified domain, e.g. "spaca <hello@example.com>".
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=
WAITLIST_EMAIL_REPLY_TO=
# Postal address shown in the email footer.
WAITLIST_MAILING_ADDRESS=
